# Copy to frontend/.env.local (never commit it). On Vercel, set these under Project > Settings > Environment Variables.

# Where the FastAPI backend runs. Local default is http://localhost:8000; on Vercel use your Render URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# true = use built-in mock data, no backend needed.
NEXT_PUBLIC_USE_MOCK=false

# Accounts are Tidewell's own (username + password, stored in Tiger Data); no keys needed here.
