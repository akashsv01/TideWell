# Copy to backend/.env and fill in. Never commit .env.
ELEVENLABS_API_KEY=
# Default premade voice "Sarah" (warm, calm). Swap for any voice_id from your ElevenLabs Voice Library.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
GEMINI_API_KEY=
# gemini-3.8-flash was 10-60s per call on 2026-10-17; 3.6-flash ~1s
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
BACKBOARD_API_KEY=
TIGER_DATABASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Comma-separated; add your Vercel URL after deploying the frontend.
FRONTEND_ORIGINS=http://localhost:3000
