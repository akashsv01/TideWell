# Copy to backend/.env and fill in. Never commit .env.
ELEVENLABS_API_KEY=
# Default premade voice "Sarah" (warm, calm). Swap for any voice_id from your ElevenLabs Voice Library.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
GEMINI_API_KEY=
# gemini-3.8-flash was 10-60s per call on 2026-10-17; 3.6-flash ~1s
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Optional: Claude answers Ask with cited web search (CDC, NIH, WHO, ACOG...). Gemini is the fallback.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
BACKBOARD_API_KEY=
TIGER_DATABASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Comma-separated; add your Vercel URL after deploying the frontend.
FRONTEND_ORIGINS=http://localhost:3000
# Video visits. By default they use video-server/ (python app.py there, port 5000).
# Use an https ngrok address here if another device must join.
WEBRTC_BASE_URL=http://localhost:5000
# Optional: Daily (https://dashboard.daily.co > Developers) is used instead when this is set.
DAILY_API_KEY=
# Doctor email when a video visit is booked (https://resend.com > API Keys). Leave empty to skip emails.
RESEND_API_KEY=
RESEND_FROM=Tidewell <onboarding@resend.dev>
DOCTOR_EMAIL=
# Address of this backend as the doctor's browser sees it (the emailed link points here). Use your Render URL when deployed.
PUBLIC_API_URL=http://localhost:8000
# Testing only: true lets you join a video visit at any time, not just 15 minutes before it.
VIDEO_JOIN_ANYTIME=false
